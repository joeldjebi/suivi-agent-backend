# Copier en « .env » dans ce dossier (deploy/) puis remplacer chaque valeur À_REMPLACER.
# Secrets : générer chacun avec   openssl rand -hex 32

# Port public du site (le seul port ouvert) et adresse d'accès.
PUBLIC_PORT=8090
# 127.0.0.1 : port fermé au public (le domaine en HTTPS passe par Apache) ; 0.0.0.0 : ouvert.
PUBLIC_BIND=127.0.0.1
CORS_ORIGIN=http://185.215.167.87:8090

# Base de données (dans son conteneur, jamais exposée).
DATABASE_NAME=suivi_agent
DATABASE_USER=suivi
DATABASE_PASSWORD=À_REMPLACER
DATABASE_APP_USER=suivi_app
DATABASE_APP_PASSWORD=À_REMPLACER

# Sauvegardes de la base : dossier (hors du code), heure UTC de la copie, jours gardés.
BACKUP_DIR=../../backups
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14

# Jetons de connexion.
JWT_SECRET=À_REMPLACER
JWT_EXPIRES_IN=15m

# Console éditeur (super administrateur).
PLATFORM_JWT_SECRET=À_REMPLACER
PLATFORM_MFA_KEY=À_REMPLACER
PLATFORM_REQUIRE_MFA=true
# Adresses IP autorisées à ouvrir la console, séparées par des virgules (vide : toutes).
PLATFORM_ALLOWED_IPS=
# Adresse secrète de la console sur le site, ex. /console-4f9k2m7x8q (lettres et chiffres).
VITE_PLATFORM_PATH=/console-À_REMPLACER

# Tuiles de carte : vide = tuiles OpenStreetMap publiques (à remplacer par un fournisseur
# dédié quand le trafic grandit, ex. MapTiler).
VITE_TILE_URL=

# Notifications push (Firebase Cloud Messaging) : clé du compte de service, copiée dans
# deploy/secrets/ (jamais dans Git). Vide : notifications push désactivées.
FIREBASE_SERVICE_ACCOUNT_FILE=/app/secrets/firebase-service-account.json

# Supervision des erreurs (Sentry) : vide = désactivée
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Sentry du site web (projet « browser » distinct de celui de l'API, facultatif)
VITE_SENTRY_DSN=
# Lien « Ouvrir Sentry » de la console éditeur (page des erreurs du projet), facultatif
SENTRY_ISSUES_URL=

# Interface web de la base (pgAdmin), facultative. Pour l'activer : décommenter les lignes,
# puis relancer le déploiement et sh cpanel/install.sh <utilisateur cPanel> <domaine> "$PGADMIN_PATH".
# COMPOSE_PROFILES=dbadmin
# (avec la version web de l'app : COMPOSE_PROFILES=dbadmin,webapp)
# Adresse secrète, ex. /db-7k2m9q4x (lettres et chiffres, au moins 8 après « db- »).
# PGADMIN_PATH=/db-À_REMPLACER
# PGADMIN_EMAIL=vous@exemple.com
# PGADMIN_PASSWORD=À_REMPLACER

# Version web de l'app (app.performx.online), facultative : ajouter « webapp » à
# COMPOSE_PROFILES (voir README). Sentry de l'app web, facultatif.
# APP_SENTRY_DSN=
