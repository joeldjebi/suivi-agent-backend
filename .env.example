PORT=3000
# Origines autorisées, séparées par des virgules. OBLIGATOIRE en production
# (l'API refuse de démarrer si vide quand NODE_ENV=production).
CORS_ORIGIN=http://localhost:5173

DATABASE_HOST=localhost
DATABASE_PORT=5434
# Propriétaire des tables : migrations uniquement
DATABASE_USER=suivi
DATABASE_PASSWORD=suivi
# Rôle utilisé par l'API (soumis à la Row Level Security)
DATABASE_APP_USER=suivi_app
DATABASE_APP_PASSWORD=suivi_app
DATABASE_NAME=suivi_agent

REDIS_HOST=localhost
REDIS_PORT=6379

# OBLIGATOIRE en production : au moins 16 caractères, jamais une valeur d'exemple
# (l'API refuse de démarrer sinon). À générer, ex. : openssl rand -base64 48
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m

# Console éditeur (super administrateur)
# Secret distinct pour ses jetons. OBLIGATOIRE en production (au moins 16 caractères) :
# en dev il est dérivé de JWT_SECRET, mais la prod exige un secret propre, sinon un JWT_SECRET
# divulgué permettrait de forger un jeton de la console éditeur.
PLATFORM_JWT_SECRET=
# Adresses IP autorisées, séparées par des virgules (vide = toutes)
PLATFORM_ALLOWED_IPS=
# Derrière un proxy (Nginx, Traefik) : nombre de proxys de confiance, pour la vraie adresse du client
TRUST_PROXY=
# Double authentification (codes à 6 chiffres) obligatoire pour tous les comptes éditeur : true en production
PLATFORM_REQUIRE_MFA=
# Clé de chiffrement des secrets de double authentification (sinon dérivée du secret des jetons)
PLATFORM_MFA_KEY=

# Notifications push : chemin de la clé du compte de service Firebase (hors du dépôt).
# Vide : notifications push désactivées.
FIREBASE_SERVICE_ACCOUNT_FILE=

# Supervision des erreurs (Sentry) : vide = désactivée
SENTRY_DSN=
